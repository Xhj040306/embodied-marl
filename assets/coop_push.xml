<mujoco model="coop_push">
  <!-- 两个机器人协作把方块推到目标区域。
       只使用 MuJoCo 内置几何体，不依赖外部 mesh / texture 文件。 -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="Euler"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <global azimuth="140" elevation="-35"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.32 0.42" rgb2="0.02 0.02 0.03"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.20 0.24 0.30" rgb2="0.14 0.17 0.22"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.05"/>
  </asset>

  <default>
    <geom friction="1.0 0.05 0.05" solref="0.02 1"/>
    <default class="agent">
      <geom type="cylinder" size="0.09 0.06" rgba="0.90 0.35 0.25 1"/>
    </default>
    <default class="puck">
      <geom type="box" size="0.07 0.07 0.06" rgba="0.95 0.80 0.25 1"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="1 -1 3" dir="-0.3 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="6 6 0.1" material="grid"/>

    <body name="agent0" pos="-0.55 -0.35 0.06">
      <freejoint name="agent0_free"/>
      <geom name="agent0_geom" class="agent"/>
    </body>

    <body name="agent1" pos="0.55 -0.35 0.06">
      <freejoint name="agent1_free"/>
      <geom name="agent1_geom" class="agent" rgba="0.25 0.55 0.90 1"/>
    </body>

    <body name="puck" pos="0 0.10 0.06">
      <freejoint name="puck_free"/>
      <geom name="puck_geom" class="puck"/>
    </body>

    <body name="goal" pos="0 0.95 0.01">
      <geom name="goal_marker" type="cylinder" size="0.26 0.015" rgba="0.20 0.90 0.35 0.35"
            contype="0" conaffinity="0"/>
      <site name="goal_site" type="cylinder" size="0.26 0.01" pos="0 0 0.02"
            rgba="0.20 0.90 0.35 0.5"/>
    </body>
  </worldbody>

  <actuator>
    <!-- 每个机器人由 2 个力执行器驱动，分别控制 x / y 方向的推力。 -->
    <motor name="agent0_fx" joint="agent0_free" gear="1 0 0 0 0 0" ctrlrange="-3 3"/>
    <motor name="agent0_fy" joint="agent0_free" gear="0 1 0 0 0 0" ctrlrange="-3 3"/>
    <motor name="agent1_fx" joint="agent1_free" gear="1 0 0 0 0 0" ctrlrange="-3 3"/>
    <motor name="agent1_fy" joint="agent1_free" gear="0 1 0 0 0 0" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
